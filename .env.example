# Base de données PostgreSQL
DATABASE_URI=postgresql://USER:PASSWORD@localhost:5432/boutique_she

# Payload CMS — secret pour JWT (générer avec: openssl rand -hex 32)
PAYLOAD_SECRET=your-payload-secret-here

# URL publique du site (sans slash final)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend (emails de confirmation commande)
RESEND_API_KEY=re_your_resend_key

# Uploadthing (optionnel — stockage fichiers en prod)
# UPLOADTHING_SECRET=sk_live_...
# UPLOADTHING_APP_ID=...
