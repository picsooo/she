# --- Meta Pixel / Conversions API ---

# ID du dataset Meta (dataset "vetements P")
NEXT_PUBLIC_FB_PIXEL_ID=1978921926256650

# Token serveur CAPI : Events Manager > Paramètres > API Conversions > Générer un token d'accès
FB_CAPI_ACCESS_TOKEN=__a_remplir__

# Version de l'API Graph (vérifier la plus récente au moment du déploiement)
FB_GRAPH_VERSION=v21.0

# Code de test (Events Manager > Tester les événements). Laisser vide en production.
FB_TEST_EVENT_CODE=

# Stratégie d'achat : "checkout" (Option A, à la commande) ou "delivery" (Option B, à la livraison)
PURCHASE_EVENT_STRATEGY=checkout
